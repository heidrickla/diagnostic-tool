// Resources for DiagnosticTool.exe. version.rh is generated by build.rs from
// the package version; numeric ids avoid needing windows.h.
#include "version.rh"

// The GUI loads this icon with MAKEINTRESOURCE(1).
1 ICON "app.ico"

// RT_MANIFEST, id 1 (CREATEPROCESS_MANIFEST_RESOURCE_ID).
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION VER_NUMERIC
PRODUCTVERSION VER_NUMERIC
FILEFLAGSMASK 0x3F
FILEFLAGS VER_FLAGS
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Lewis Heidrick"
            VALUE "FileDescription", "Diagnostic Tool"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "DiagnosticTool"
            VALUE "LegalCopyright", "Copyright 2026 Lewis Heidrick"
            VALUE "OriginalFilename", "DiagnosticTool.exe"
            VALUE "ProductName", "Diagnostic Tool"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
